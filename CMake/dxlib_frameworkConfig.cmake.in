@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@DXF_BUILD_NATIVE@)
    if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(dxlib_framework_FOUND FALSE)
        set(dxlib_framework_NOT_FOUND_MESSAGE "This installed native package requires Windows/MSVC x64")
        return()
    endif()
    set(_dxf_saved_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(DxLib)
    set(CMAKE_MODULE_PATH "${_dxf_saved_module_path}")
    unset(_dxf_saved_module_path)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/dxlib_frameworkTargets.cmake")
# Call this for application targets linking the official static-CRT VC SDK.
function(dxf_use_static_runtime Target)
    if(MSVC)
        set_property(TARGET ${Target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
    endif()
endfunction()
check_required_components(dxlib_framework)
